<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Icono Oficial de la App: Centrado, optimizado para OLED y usado para forzar su permanencia en el APK -->
        <ImageView
            android:id="@+id/img_app_logo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Logo Alert Battery" />

        <!-- Titulo de la app -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Alert Battery Level"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="24dp"/>

        <!-- Interruptor Principal -->
        <Switch
            android:id="@+id/switch_enable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Activar Alerta"
            android:textSize="18sp"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="24dp"/>

        <!-- Porcentaje de Batería -->
        <TextView
            android:id="@+id/tv_percentage_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Avisar cuando la batería llegue al: 100%"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"/>

        <SeekBar
            android:id="@+id/seek_percentage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="100"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"/>

        <!-- Opciones de Alerta -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tipo de Sonido"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/rg_sound_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">
            <RadioButton android:id="@+id/rb_voice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Alerta por voz" android:textColor="?android:attr/textColorPrimary"/>
            <RadioButton android:id="@+id/rb_beep" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Beep" android:textColor="?android:attr/textColorPrimary"/>
            <RadioButton android:id="@+id/rb_silent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Solo notificación visual" android:textColor="?android:attr/textColorPrimary"/>
        </RadioGroup>

        <!-- Bucle de repetición -->
        <Switch
            android:id="@+id/switch_loop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Repetir cada 10 segundos"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="24dp"/>

        <!-- Vibración -->
        <Switch
            android:id="@+id/switch_vibrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Activar Vibración"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="24dp"/>

        <!-- Ajuste de Volumen -->
        <TextView
            android:id="@+id/tv_volume_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volumen del aviso: 80%"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"/>

        <SeekBar
            android:id="@+id/seek_volume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="80"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp"/>

        <!-- Configuración de optimización de batería (Para Samsung, Xiaomi, etc) -->
        <Button
            android:id="@+id/btn_battery_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configurar Fiabilidad (Sin restricciones)"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nota: Para garantizar que el aviso suene tras reiniciar o en reposo profundo, pulsa el botón de arriba, busca esta app y selecciona 'Sin restricciones' o activa 'Inicio automático'."
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"/>

    </LinearLayout>
</ScrollView>
