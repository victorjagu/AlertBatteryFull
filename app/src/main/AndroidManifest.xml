<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ======================================================================= -->
    <!-- 1. PERMISOS DEL SISTEMA OPERATIVO                                       -->
    <!-- ======================================================================= -->

    <!-- Permisos para enviar notificaciones de alerta (Obligatorio en Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Permisos esenciales para ejecutar y mantener el motor en segundo plano -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    
    <!-- Permiso para pedir la exclusion del modo Doze (ahorro de bateria del sistema) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Permiso para reactivar las alertas automaticamente al encender el telefono -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    
    <!-- Permisos de red requeridos para comprobar la conectividad Wi-Fi -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    
    <!-- Permisos de localizacion (GPS): Obligatorios en Android 12+ para leer el nombre (SSID) del Wi-Fi -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" /> 
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- ======================================================================= -->
    <!-- 2. CONFIGURACION DE LA APLICACION                                       -->
    <!-- ======================================================================= -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Alert Battery Level"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AlertBatteryLevel"

        <!-- --- COMPONENTE 1: PANTALLA PRINCIPAL --- -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- --- COMPONENTE 2: MOTOR DE MONITOREO DE BATERIA --- -->
        <service
            android:name=".BatteryMonitorService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            
            <!-- Propiedad oficial requerida por Google Play para declarar el subtipo de servicio especial -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Monitoreo continuo y eficiente del nivel de bateria para lanzar alertas multimedia al usuario." />
        </service>

        <!-- --- COMPONENTE 3: DESPERTADOR AUTOMATICO (REINICIOS) --- -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
