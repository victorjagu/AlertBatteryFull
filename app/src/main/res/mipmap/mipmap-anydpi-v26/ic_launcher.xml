<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Mantenemos el fondo blanco limpio de Android -->
    <background android:drawable="@android:color/white" />
    
    <!-- CAMBIADO: Añadimos un inset del 18% para encoger la imagen al centro seguro -->
    <!-- CAMBIADO: Apuntamos correctamente a la carpeta @mipmap en lugar de @drawable -->
    <foreground>
        <inset
            android:drawable="@mipmap/ic_launcher"  
            android:inset="18%" />   
    </foreground>
</adaptive-icon>
