<resources>
    <style name="Theme.AlertBattery" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Cambiado de #FFFFFF a verde -->
        <item name="android:windowBackground">#79c889</item> 
        <item name="android:statusBarColor">#79c889</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Cambia la barra de navegación inferior (botones atrás y home) -->
        <item name="android:navigationBarColor">#79c889</item>
        <!-- Hace que los iconos (atrás/home) sean oscuros para que se vean bien sobre el claro -->
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
